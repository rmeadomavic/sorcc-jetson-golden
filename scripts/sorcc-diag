#!/bin/bash
# sorcc-diag - collect a snapshot of a SORCC AI Kit's state for remote troubleshooting.
# Usage: sudo sorcc-diag [outdir]
# Writes /tmp/sorcc-diag-<hostname>-<time>.tar.gz by default. The Hydra API token is
# masked; send the tarball to whoever is helping you.

set -u
OUTDIR="${1:-/tmp}"
STAMP="$(date +%Y%m%d-%H%M%S)"
NAME="sorcc-diag-$(hostname)-${STAMP}"
WORK="$(mktemp -d)"
DEST="${WORK}/${NAME}"
mkdir -p "${DEST}"

run() { local f="${DEST}/$1"; shift; { echo "# $*"; "$@"; } >"${f}" 2>&1 || true; }

run hostname.txt          hostname
run os-release.txt        cat /etc/os-release
run nv_tegra_release.txt  cat /etc/nv_tegra_release
run l4t-packages.txt      bash -c "dpkg -l 'nvidia-l4t-*' | tail -n +6"
run uname.txt             uname -a
run nvpmodel.txt          nvpmodel -q
run bootctrl.txt          nvbootctrl dump-slots-info
run gpu-maxfreq.txt       bash -c 'cat /sys/devices/platform/*gpu*/devfreq/*/max_freq /sys/devices/*gpu*/devfreq/*/max_freq 2>/dev/null'
run free.txt              free -h
run df.txt                df -h
run lsblk.txt             lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS,MODEL
run swap.txt              swapon --show
run uptime.txt            uptime
run ip-a.txt              ip -brief address
run docker-ps.txt         docker ps -a
run docker-images.txt     docker images --digests
run docker-info.txt       docker info
run ollama-list.txt       ollama list
run ollama-version.txt    ollama -v
run snap-list.txt         snap list
run services.txt          systemctl status --no-pager sorcc-launcher ollama comfyui hydra-detect docker
run systemctl-failed.txt  systemctl --failed --no-pager
run launcher-status.txt   curl -sS --max-time 5 http://127.0.0.1:8090/status
run journal-launcher.txt  journalctl -u sorcc-launcher -n 300 --no-pager
run journal-ollama.txt    journalctl -u ollama -n 300 --no-pager
run journal-comfyui.txt   journalctl -u comfyui -n 300 --no-pager
run journal-hydra.txt     journalctl -u hydra-detect -n 300 --no-pager
run journal-boot.txt      journalctl -b -n 500 --no-pager
run journal-kernel.txt    journalctl -k -n 500 --no-pager
run dmesg.txt             dmesg
run lsusb.txt             lsusb
run video-devs.txt        bash -c 'ls -l /dev/video*'
run v4l2-devs.txt         v4l2-ctl --list-devices
run install-log.txt       tail -n 400 /var/log/sorcc-install.log
run hydra-config.txt      sed -E 's/^(api_token[[:space:]]*=).*/\1 <masked>/' /opt/sorcc/hydra/config.ini
run opt-sorcc.txt         bash -c 'ls -laR /opt/sorcc | grep -v "^total" | head -200'

tar -C "${WORK}" -czf "${OUTDIR}/${NAME}.tar.gz" "${NAME}"
rm -rf "${WORK}"
echo "Wrote ${OUTDIR}/${NAME}.tar.gz"
